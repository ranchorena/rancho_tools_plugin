# Variables de entorno para Docker Compose
# Accesible desde el navegador. backend:5000 solo existe dentro de la red de Compose.
API_URL=http://localhost:5000
GEOSERVER_URL=http://localhost:8087/geoserver
FLASK_ENV=development
FLASK_APP=server.py
FLASK_DEBUG=1
# DEV habitual, proceso raapi en Windows. La PostgreSQL de referencia es la del host.
DB_USER=postgres
# O tu contraseña preferida. El comentario va en su propia línea: un loader que no sea Compose lo tomaría como parte de la clave.
DB_PASSWORD=postgres
DB_NAME=postgres
DB_SCHEMA=generalbelgrano
DB_HOST=localhost
DB_PORT=5432
# Contenedor raapi. No reutilizar DB_HOST: localhost dentro del contenedor no es el host.
DB_HOST_DOCKER=host.docker.internal
DB_PORT_DOCKER=5432
# Instalación standalone: DB_HOST_DOCKER=db y docker compose --profile standalone up -d db

# Keycloak local. Los valores reales van en .env, ignorado por Git.
# start-dev y el usuario rancho/rancho-demo son solo DEV.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me
RANCHO_DEMO_USER=rancho
RANCHO_DEMO_PASSWORD=rancho-demo
KEYCLOAK_URL=http://localhost:8081
# El claim iss no cambia entre host y Docker.
KEYCLOAK_ISSUER=http://localhost:8081/realms/rancho
# JWKS del proceso en el host. Dentro del contenedor raapi, Compose usa KEYCLOAK_JWKS_URL_DOCKER.
KEYCLOAK_JWKS_URL=http://127.0.0.1:8081/realms/rancho/protocol/openid-connect/certs
KEYCLOAK_JWKS_URL_DOCKER=http://keycloak:8080/realms/rancho/protocol/openid-connect/certs
RA_API_AUDIENCE=raapi
# 8082 es el frontend de Compose. 8080 es npm run dev. 8088 es ra-proxy.
CORS_ORIGINS=http://localhost:8082,http://localhost:8080,http://localhost:8088
# Para usar ra-proxy como única origen del navegador, recompilar raweb con:
# API_URL=http://localhost:8088
# GEOSERVER_URL=http://localhost:8088/geoserver
# KEYCLOAK_URL=http://localhost:8088
# y KC_HOSTNAME=http://localhost:8088. El issuer del token tiene que coincidir.
KEYCLOAK_CLIENT_ID=ra-mcp
KEYCLOAK_CLIENT_SECRET=change-me
RA_MCP_PUBLIC_URL=http://localhost:8000
RA_MCP_JWT_SIGNING_KEY=change-me
RA_MCP_OAUTH_STORAGE_KEY=change-me