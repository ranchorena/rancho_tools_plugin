# URL base de raapi, accesible desde el proceso del MCP.
# Ejemplo local: http://localhost:5000
RA_API_BASE_URL=

# Tiempo de espera HTTP en segundos. Si se omite, el valor es 30.
# RA_API_TIMEOUT=30

# Transporte normal: http. stdio queda solo para tests y no exige OAuth.
RA_MCP_TRANSPORT=http
RA_MCP_PORT=8000
RA_MCP_PUBLIC_URL=http://localhost:8000
KEYCLOAK_ISSUER=http://localhost:8081/realms/rancho
KEYCLOAK_JWKS_URL=http://127.0.0.1:8081/realms/rancho/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=ra-mcp
KEYCLOAK_CLIENT_SECRET=
RA_API_AUDIENCE=raapi
RA_MCP_JWT_SIGNING_KEY=
RA_MCP_OAUTH_STORAGE_KEY=
