# Solo para npm run build / npm run dev fuera de Docker, con los puertos directos.
# Con Docker Compose estas tres salen de PUBLIC_URL en el .env de la raíz: no se leen de aquí.
API_URL=http://localhost:5001/api/v1
GEOSERVER_URL=http://localhost:8087/geoserver
KEYCLOAK_URL=http://localhost:8081
# Icono de los marcadores de pedido: medialuna o limon.
MARCADOR_ICONO=medialuna
# Clave de Google Maps Platform, con Maps Embed API y Maps JavaScript API.
# Se graba en el bundle: restringirla por referrer (localhost:8080, localhost:8082, localhost:8088 y el host de ngrok).
# Vacía: Ver calle abre Google Maps en otra pestaña. Hay que recompilar si cambia.
GOOGLE_MAPS_API_KEY=
