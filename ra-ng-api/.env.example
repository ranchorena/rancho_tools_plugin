# Arranque manual en Windows. Docker Compose no usa este archivo:
# inyecta las variables y, si alguna ya existe, tiene prioridad sobre .env.
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_SCHEMA=generalbelgrano
KEYCLOAK_ISSUER=http://localhost:8088/realms/rancho
KEYCLOAK_JWKS_URL=http://127.0.0.1:8081/realms/rancho/protocol/openid-connect/certs
RA_API_AUDIENCE=raapi
CORS_ORIGINS=http://localhost:8088,http://localhost:8082,http://localhost:8080
