{
  "realm": "rancho",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "loginTheme": "rancho",
  "internationalizationEnabled": true,
  "supportedLocales": ["es"],
  "defaultLocale": "es",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 0,
  "revokeRefreshToken": false,
  "accessTokenLifespanForImplicitFlow": 0,
  "roles": {
    "client": {
      "raapi": [
        {
          "name": "clientes:read",
          "description": "Buscar clientes y consultar pedidos",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "pedidos:write",
          "description": "Registrar, eliminar e iniciar pedidos",
          "composite": false,
          "clientRole": true
        }
      ]
    }
  },
  "clientScopes": [
    {
      "name": "basic",
      "description": "Claim sub del usuario",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "rancho-identidad",
      "description": "preferred_username y email en el access token",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "preferred-username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "raapi-audience",
      "description": "Agrega la audiencia raapi. El parametro audience del Token Exchange V2 solo filtra audiencias que ya existen.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audience-raapi",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "raapi",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "raapi-roles",
      "description": "Roles de cliente raapi en resource_access.raapi.roles",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "raapi-client-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "usermodel.clientRoleMapping.clientId": "raapi",
            "claim.name": "resource_access.${client_id}.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "ra-mcp-audience",
      "description": "Audiencia propia del token upstream que valida ra-mcp. No es la audiencia de raapi.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audience-ra-mcp",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ra-mcp",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "raweb",
      "name": "raweb",
      "description": "Cliente publico OIDC de la aplicacion web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://localhost:8082/",
        "http://localhost:8082/silent-check-sso.html"
      ],
      "webOrigins": [
        "http://localhost:8082"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8082/",
        "oauth2.device.authorization.grant.enabled": "false",
        "standard.token.exchange.enabled": "false"
      },
      "defaultClientScopes": [
        "basic",
        "rancho-identidad",
        "raapi-audience",
        "raapi-roles"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "raapi",
      "name": "raapi",
      "description": "Resource server. Audiencia de los access tokens downstream.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "standard.token.exchange.enabled": "false"
      }
    },
    {
      "clientId": "ra-mcp",
      "name": "ra-mcp",
      "description": "Cliente confidencial de FastMCP. El secret lo fija el bootstrap DEV y no vive en este archivo.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://localhost:8000/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:8000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "standard.token.exchange.enabled": "true",
        "oauth2.device.authorization.grant.enabled": "false"
      },
      "defaultClientScopes": [
        "basic",
        "rancho-identidad",
        "raapi-audience",
        "raapi-roles",
        "ra-mcp-audience"
      ],
      "optionalClientScopes": []
    }
  ],
  "clientScopeMappings": {
    "raapi": [
      {
        "client": "raweb",
        "roles": ["clientes:read", "pedidos:write"]
      },
      {
        "client": "ra-mcp",
        "roles": ["clientes:read", "pedidos:write"]
      }
    ]
  }
}
